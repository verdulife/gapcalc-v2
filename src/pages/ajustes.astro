---
import Layout from "@/layouts/Layout.astro";
import OptionsComponent from "@/components/Options.svelte";
import { getAjustesData } from "@/lib/db-ajustes";

const { papers, plotters, tshirts, vars } = await getAjustesData();
---

<Layout title="Ajustes">
  <div class="flex flex-col gap-4 p-4">
    <div class="flex justify-between items-center">
      <h1 class="text-xl font-bold">Panel de Ajustes</h1>
      <a href="/api/logout" class="text-sm text-gray-500 hover:text-red-400 transition-colors">
        Cerrar sesión
      </a>
    </div>
    <OptionsComponent
      client:load
      {papers}
      {plotters}
      {tshirts}
      {vars}
    />
  </div>
</Layout>